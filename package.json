{
  "name": "@ai-ecoverse/slicc-spectrum",
  "version": "0.0.0",
  "description": "Web components for SLICC on Spectrum Web Components: the terminal, the app shell and its surfaces",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ai-ecoverse/slicc-spectrum.git"
  },
  "engines": {
    "node": ">=24"
  },
  "fledgling": {
    "provider": "github",
    "workflow": "ci.yml",
    "repo": "ai-ecoverse/slicc-spectrum",
    "publish": true
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/slicc-terminal.js"
    },
    "./ui": {
      "types": "./dist/types/ui.d.ts",
      "default": "./dist/slicc-ui.js"
    },
    "./dummy": {
      "types": "./dist/types/dummy.d.ts",
      "default": "./dist/slicc-dummy.js"
    },
    "./kernel": {
      "types": "./dist/types/kernel.d.ts",
      "default": "./dist/slicc-kernel-model.js"
    },
    "./swc.css": "./dist/swc.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepare": "slicc-install-hooks",
    "build": "node build.mjs",
    "prepack": "npm run build",
    "trust": "npx fledgling sync -y --skip-publish",
    "trust:dry": "npx fledgling sync --dry-run -y --skip-publish",
    "release": "semantic-release",
    "start": "npm run build && node test/integration/chrome.mjs",
    "pretest": "npm run build && slicc-cdp install-browser",
    "test": "node --test ${TEST_CONCURRENCY:+--test-concurrency=$TEST_CONCURRENCY} --test-global-setup=node_modules/@ai-ecoverse/slicc-shared-web/harness/global.mjs 'test/integration/*.test.mjs'",
    "review:browser": "node .github/scripts/review-browser.mjs",
    "test:unit": "NODE_NO_WARNINGS=1 mcr -c mcr.config.mjs node --test 'test/unit/**/*.test.mjs'",
    "typecheck": "tsc && tsc -p compat",
    "lint": "slicc-lint",
    "format": "biome check --write ."
  },
  "devDependencies": {
    "@adobe/spectrum-wc": "2.0.0-beta.5",
    "@adobe/spectrum-wc-icons": "2.0.0-beta.5",
    "@ai-ecoverse/slicc-cdp": "1.30.23",
    "@ai-ecoverse/slicc-kernel": "1.143.2",
    "@ai-ecoverse/slicc-shared-web": "2.7.4",
    "@ai-ecoverse/slicc-vault": "1.15.2",
    "@ai-ecoverse/wasm-bash": "5.3.0-22",
    "@ai-ecoverse/wasm-coreutils": "9.12.0-12",
    "@biomejs/biome": "2.5.15",
    "@fontsource/source-code-pro": "5.3.1",
    "@happy-dom/global-registrator": "21.0.3",
    "@pierre/diffs": "1.6.1",
    "@pierre/trees": "1.0.0-beta.6",
    "@spectrum-web-components/action-menu": "1.12.4",
    "@spectrum-web-components/alert-dialog": "1.12.4",
    "@spectrum-web-components/field-label": "1.12.4",
    "@spectrum-web-components/help-text": "1.12.4",
    "@spectrum-web-components/menu": "1.12.4",
    "@spectrum-web-components/picker": "1.12.4",
    "@spectrum-web-components/search": "1.12.4",
    "@spectrum-web-components/switch": "1.12.4",
    "@spectrum-web-components/textfield": "1.12.4",
    "@spectrum-web-components/theme": "1.12.4",
    "@types/mdast": "4.0.4",
    "@types/node": "26.6.5",
    "@wterm/core": "0.5.4",
    "@wterm/dom": "0.5.4",
    "@wterm/ghostty": "0.5.4",
    "dockview-core": "8.5.1",
    "esbuild": "0.28.2",
    "happy-dom": "21.0.3",
    "lefthook": "2.2.2",
    "lucide": "1.57.0",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-gfm-autolink-literal": "2.0.1",
    "mdast-util-gfm-strikethrough": "2.0.1",
    "mdast-util-gfm-table": "2.0.0",
    "mdast-util-gfm-task-list-item": "2.0.0",
    "micromark-extension-gfm-autolink-literal": "2.1.0",
    "micromark-extension-gfm-strikethrough": "2.1.0",
    "micromark-extension-gfm-table": "2.1.2",
    "micromark-extension-gfm-task-list-item": "2.1.0",
    "monocart-coverage-reports": "2.13.2",
    "semantic-release": "25.0.9",
    "typescript": "7.0.2",
    "uqr": "0.1.3"
  }
}
