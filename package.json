{
  "name": "@ai-ecoverse/slicc-spectrum",
  "version": "0.0.0",
  "description": "Web components for SLICC on Spectrum Web Components: the terminal, the app shell and its surfaces",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ai-ecoverse/slicc-spectrum.git"
  },
  "engines": {
    "node": ">=24"
  },
  "fledgling": {
    "provider": "github",
    "workflow": "release.yml",
    "repo": "ai-ecoverse/slicc-spectrum",
    "publish": true
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/slicc-terminal.js"
    },
    "./ui": {
      "types": "./dist/types/ui.d.ts",
      "default": "./dist/slicc-ui.js"
    },
    "./dummy": {
      "types": "./dist/types/dummy.d.ts",
      "default": "./dist/slicc-dummy.js"
    },
    "./kernel": {
      "types": "./dist/types/kernel.d.ts",
      "default": "./dist/slicc-kernel-model.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepare": "lefthook install",
    "build": "node build.mjs",
    "prepack": "npm run build",
    "trust": "npx fledgling sync -y --skip-publish",
    "trust:dry": "npx fledgling sync --dry-run -y --skip-publish",
    "release": "semantic-release",
    "start": "npm run build && node test/integration/chrome.mjs",
    "pretest": "npm run build && playwright-core install --no-shell chromium",
    "test": "node --test --test-global-setup=node_modules/@ai-ecoverse/slicc-shared-web/harness/global.mjs 'test/integration/*.test.mjs'",
    "test:unit": "NODE_NO_WARNINGS=1 mcr -c node_modules/@ai-ecoverse/slicc-shared-web/mcr.config.mjs node --test 'test/unit/**/*.test.mjs'",
    "typecheck": "tsc",
    "lint": "slicc-lint",
    "format": "biome check --write ."
  },
  "peerDependencies": {
    "@shikijs/langs": "4.5.0",
    "@shikijs/themes": "4.5.0"
  },
  "peerDependenciesMeta": {
    "@shikijs/langs": {
      "optional": true
    },
    "@shikijs/themes": {
      "optional": true
    }
  },
  "devDependencies": {
    "@adobe/spectrum-wc": "2.0.0-beta.4",
    "@adobe/spectrum-wc-icons": "2.0.0-beta.4",
    "@ai-ecoverse/slicc-kernel": "1.17.4",
    "@ai-ecoverse/slicc-shared-web": "1.9.0",
    "@ai-ecoverse/wasm-bash": "5.3.0-8",
    "@ai-ecoverse/wasm-coreutils": "9.7.0-3",
    "@biomejs/biome": "2.5.15",
    "@fontsource/source-code-pro": "5.3.0",
    "@happy-dom/global-registrator": "20.14.5",
    "@pierre/diffs": "1.5.1",
    "@pierre/trees": "1.0.0-beta.6",
    "@spectrum-web-components/action-button": "1.12.4",
    "@spectrum-web-components/action-group": "1.12.4",
    "@spectrum-web-components/action-menu": "1.12.4",
    "@spectrum-web-components/alert-dialog": "1.12.4",
    "@spectrum-web-components/badge": "1.12.4",
    "@spectrum-web-components/button": "1.12.4",
    "@spectrum-web-components/field-label": "1.12.4",
    "@spectrum-web-components/help-text": "1.12.4",
    "@spectrum-web-components/menu": "1.12.4",
    "@spectrum-web-components/picker": "1.12.4",
    "@spectrum-web-components/progress-circle": "1.12.4",
    "@spectrum-web-components/search": "1.12.4",
    "@spectrum-web-components/switch": "1.12.4",
    "@spectrum-web-components/textfield": "1.12.4",
    "@spectrum-web-components/theme": "1.12.4",
    "@types/node": "26.6.4",
    "@wterm/core": "0.5.4",
    "@wterm/dom": "0.5.4",
    "dockview-core": "8.4.0",
    "esbuild": "0.28.2",
    "happy-dom": "20.14.5",
    "lefthook": "2.1.17",
    "lucide": "1.52.0",
    "monocart-coverage-reports": "2.13.0",
    "playwright-core": "1.63.0",
    "semantic-release": "25.0.9",
    "typescript": "7.0.2"
  }
}
